# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your keys never get committed.

# ── Supabase (Dashboard → Project Settings → API Keys) ─────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (starts with sb_secret_…) or the legacy "service_role" key.
# Used only on the server (Next.js API routes). Never rename it to NEXT_PUBLIC_…
SUPABASE_SECRET_KEY=

# Only for `npm run db:push` (migrations). Dashboard → Connect → "Session pooler" URI,
# with your database password filled in. Server/CLI only — never NEXT_PUBLIC_.
SUPABASE_DB_URL=

# Storage bucket that holds the shop logo (created by the first migration)
SUPABASE_LOGO_BUCKET=shop-assets

# Country code added to 10-digit customer WhatsApp numbers (91 = India)
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# ── Optional: WhatsApp Cloud API (fully automatic sending) ─────────────
# Leave these empty to use the share sheet / "open chat + attach PDF" flow.
# With them set, the Share button sends the PDF straight to the customer.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with a DOCUMENT header (needed to message customers who
# haven't written to you in the last 24 h). Leave empty to send a plain document.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Set to false if your template body has no {{1}} {{2}} {{3}} variables
# ({{1}} customer name, {{2}} invoice no, {{3}} total).
WHATSAPP_TEMPLATE_BODY_PARAMS=true
WHATSAPP_API_VERSION=v23.0
